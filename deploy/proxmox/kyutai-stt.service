[Unit]
Description=Kyutai Speech-to-Text Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kyutai-stt
Environment=PATH=/root/.cargo/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
Environment=HF_HOME=/root/.cache/huggingface
Environment=HF_HUB_ENABLE_HF_TRANSFER=1
Environment=BATCH_SIZE=4
ExecStart=/opt/kyutai-stt/.venv/bin/python /opt/kyutai-stt/local_server.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
